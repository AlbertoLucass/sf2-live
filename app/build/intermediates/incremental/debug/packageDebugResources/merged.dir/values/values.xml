    <color name="panel_background">#1A2229</color>
    <color name="primary">#FFC107</color>
    <color name="text_primary">#F5F7F8</color>
    <color name="text_secondary">#B8C2C9</color>
    <string name="app_name">SF2 Live</string>
    <style name="Theme.SF2Live" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/primary</item>
